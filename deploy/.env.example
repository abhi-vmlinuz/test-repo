# RLabZ CTF + Nexus Integration — Environment Template
# Copy to .env (never commit .env with real secrets):
#   cp deploy/.env.example .env

# Database (Postgres)
POSTGRES_USER=rlabz
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ctf_platform
DATABASE_URL=postgresql://rlabz:change-me-postgres-password@127.0.0.1:5432/ctf_platform

# Backend Auth & CORS
JWT_SECRET=change-me-jwt-secret-min-32-chars
CORS_ORIGINS=http://localhost:3000

# Nexus Execution Plane (single-host default: 127.0.0.1:8081)
NEXUS_ENGINE_URL=http://127.0.0.1:8081
NEXUS_API_KEY=
VITE_NEXUS_URL=http://127.0.0.1:8081
REGISTRY_PROXY_TARGET=127.0.0.1:5000

# Judge0 Grading Engine
JUDGE0_URL=http://127.0.0.1:2358
GHCR_USERNAME=localhost:5000
GHCR_TOKEN=
