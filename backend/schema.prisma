// ============================================
// FINAL EXAM MODULE
// ============================================

model FinalExam {
  id               String              @id @default(uuid())
  title            String
  description      String?
  instructions     String?
  courseId         String? // Course to pull random questions from
  duration         Int                 @default(60) // Duration in minutes
  passPercentage   Int                 @default(80)
  retryLimit       Int? // null = unlimited
  cooldownHours    Int                 @default(24) // Hours between retries
  questionCount    Int                 @default(30)
  isPublished      Boolean             @default(false)
  startDate        DateTime?
  endDate          DateTime?
  visibility       FinalExamVisibility @default(ALL)
  shuffleQuestions Boolean             @default(true)
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  questions               FinalExamQuestion[]
  accessRequests          FinalExamAccessRequest[]
  accessCodes             FinalExamAccessCode[]
  attempts                FinalExamAttempt[]
  course                  Course?                  @relation(fields: [courseId], references: [id])
  certificationExamConfig CertificationExamConfig?

  @@index([isPublished])
  @@index([courseId])
  @@index([startDate, endDate])
  @@map("final_exams")
}

model FinalExamQuestion {
  id               String                @id @default(uuid())
  examId           String
  questionText     String
  questionType     FinalExamQuestionType @default(MCQ)
  options          Json // Array of {id, text} for MCQ
  correctAnswer    String // Option ID or "true"/"false"
  explanation      String?
  points           Int                   @default(1)
  orderIndex       Int                   @default(0)
  sourceQuizId     String? // If pulled from module quiz
  sourceQuestionId String? // Original question ID
  createdAt        DateTime              @default(now())

  exam    FinalExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers FinalExamAnswer[]

  @@index([examId])
  @@map("final_exam_questions")
}

model FinalExamAccessRequest {
  id          String                       @id @default(uuid())
  examId      String
  userId      String
  message     String?
  status      FinalExamAccessRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  exam FinalExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([examId])
  @@index([userId])
  @@index([status])
  @@map("final_exam_access_requests")
}

model FinalExamAccessCode {
  id         String    @id @default(uuid())
  examId     String
  userId     String
  code       String    @unique
  isRedeemed Boolean   @default(false)
  redeemedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  exam    FinalExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt FinalExamAttempt?

  @@index([examId])
  @@index([userId])
  @@index([code])
  @@map("final_exam_access_codes")
}

model FinalExamAttempt {
  id            String    @id @default(uuid())
  examId        String
  userId        String
  accessCodeId  String    @unique
  attemptNumber Int       @default(1)
  score         Int       @default(0)
  maxScore      Int
  percentage    Decimal   @db.Decimal(5, 2)
  passed        Boolean   @default(false)
  timeSpent     Int? // Seconds
  totalPausedSeconds Int    @default(0)
  isPaused      Boolean   @default(false)
  pausedAt      DateTime?
  ipAddress     String?
  userAgent     String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  exam                     FinalExam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessCode               FinalExamAccessCode       @relation(fields: [accessCodeId], references: [id])
  answers                  FinalExamAnswer[]
  proctoringLogs           FinalExamProctoringLog[]
  certificationExamAttempt CertificationExamAttempt?

  @@index([examId])
  @@index([userId])
  @@index([startedAt])
  @@map("final_exam_attempts")
}

model FinalExamAnswer {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  pointsEarned   Int      @default(0)
  answeredAt     DateTime @default(now())

  attempt  FinalExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question FinalExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("final_exam_answers")
}

model FinalExamProctoringLog {
  id        String                       @id @default(uuid())
  attemptId String
  eventType FinalExamProctoringEventType
  metadata  Json? // Additional event data
  timestamp DateTime                     @default(now())

  attempt FinalExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
  @@map("final_exam_proctoring_logs")
}

