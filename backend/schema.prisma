generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  type        RoleType     @default(STUDENT)
  users       User[]
  permissions Permission[] @relation("PermissionToRole")

  @@index([name])
  @@index([type])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())
  roles       Role[]   @relation("PermissionToRole")

  @@index([module, action])
}

model User {
  id                              String                     @id @default(uuid())
  name                            String
  email                           String                     @unique
  password                        String
  phone                           String?
  avatar                          String?
  bio                             String?
  roleId                          String
  orgId                           String?
  deptId                          String?
  isActive                        Boolean                    @default(true)
  isVerified                      Boolean                    @default(false)
  emailVerifiedAt                 DateTime?
  isLocked                        Boolean                    @default(false)
  lockReason                      String?
  lockedAt                        DateTime?
  lockedUntil                     DateTime?
  failedLoginAttempts             Int                        @default(0)
  lastLoginAt                     DateTime?
  lastLoginIp                     String?
  lastLoginUserAgent              String?
  passwordChangedAt               DateTime                   @default(now())
  mustChangePassword              Boolean                    @default(false)
  mfaEnabled                      Boolean                    @default(false)
  mfaSecret                       String?
  mfaBackupCodes                  String[]                   @default([])
  totalPoints                     Int                        @default(0)
  currentStreak                   Int                        @default(0)
  longestStreak                   Int                        @default(0)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  ctfScore                        Int                        @default(0)
  isLmsUser                       Boolean                    @default(false)
  github_id                       String?                    @unique
  avatar_url                      String?
  google_id                       String?                    @unique
  social_links                    Json?                      @default("{}")
  google_avatar                   String?
  github_avatar                   String?
  lmsOnboarded                    Boolean                    @default(false)
  assignmentSubmissions           AssignmentSubmission[]
  auditLogs                       AuditLog[]
  certificates                    Certificate[]
  chatMemberships                 ChatMember[]
  chatMessages                    ChatMessage[]
  chatbotConversations            ChatbotConversation[]
  chatbotMessages                 ChatbotMessage[]
  reviews                         CourseReview[]
  createdCourses                  Course[]                   @relation("CourseCreator")
  instructedCourses               Course[]                   @relation("CourseInstructor")
  ctf_active_sessions             ctf_active_sessions[]
  ctfDockerInstances              CtfDockerInstance[]
  ctfEnrollments                  CtfEnrollment[]
  ctfNotificationsSent            CtfNotification[]          @relation("CtfNotificationSender")
  ctf_otp_codes                   ctf_otp_codes[]
  ctfProgress                     CtfProgress[]
  ctfPublicProgress               CtfPublicProgress[]
  ctfNotifications                CtfUserNotification[]
  enrollmentCodes                 EnrollmentCode[]
  enrollments                     Enrollment[]
  forumComments                   ForumComment[]
  forumPosts                      ForumPost[]
  internships                     Internship[]
  magicLoginTokens                MagicLoginToken[]
  receivedMessages                Message[]                  @relation("MessageReceiver")
  sentMessages                    Message[]                  @relation("MessageSender")
  notifications                   Notification[]
  offerLetterRequests             OfferLetterRequest[]
  otps                            Otp[]
  passwordResetTokens             PasswordResetToken[]
  payments                        Payment[]
  pinnedMessages                  PinnedMessage[]
  quizAttempts                    QuizAttempt[]
  refreshTokens                   RefreshToken[]
  securityEvents                  SecurityEvent[]
  subscriptions                   Subscription[]
  topicHighlights                 TopicHighlight[]
  topicNotes                      TopicNote[]
  topicProgress                   TopicProgress[]
  achievements                    UserAchievement[]
  userAnalytics                   UserAnalytics[]
  badges                          UserBadge[]
  otpSettings                     UserOtpSettings?
  profile                         UserProfile?
  userSessions                    UserSession[]
  department                      Department?                @relation("DepartmentMembers", fields: [deptId], references: [id])
  organization                    Organization?              @relation(fields: [orgId], references: [id])
  role                            Role                       @relation(fields: [roleId], references: [id])
  // Final Exam relations
  finalExamAccessRequests         FinalExamAccessRequest[]
  finalExamAccessCodes            FinalExamAccessCode[]
  finalExamAttempts               FinalExamAttempt[]
  // Certification Exam relations
  certificationExamAttempts       CertificationExamAttempt[] @relation("CertificationExamStudent")
  gradedCertificationAttempts     CertificationExamAttempt[] @relation("CertificationExamGrader")
  createdCertificationExamConfigs CertificationExamConfig[]  @relation("CertificationExamCreator")

  @@index([email])
  @@index([roleId])
  @@index([orgId])
  @@index([isActive])
  @@map("users")
}

model UserProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  dateOfBirth           DateTime?
  gender                String?
  country               String?
  city                  String?
  timezone              String?
  language              String    @default("en")
  linkedinUrl           String?
  githubUrl             String?
  twitterUrl            String?
  websiteUrl            String?
  emailNotifications    Boolean   @default(true)
  pushNotifications     Boolean   @default(true)
  marketingEmails       Boolean   @default(false)
  courseRecommendations Boolean   @default(true)
  profileVisibility     String    @default("PUBLIC")
  showEmail             Boolean   @default(false)
  showPhone             Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Organization {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  description  String?
  logo         String?
  website      String?
  contactEmail String?
  phone        String?
  address      String?
  maxUsers     Int?
  maxCourses   Int?
  features     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  courses      Course[]
  departments  Department[]
  users        User[]

  @@index([slug])
  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  name           String
  description    String?
  orgId          String
  parentDeptId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentDept     Department?  @relation("SubDepartments", fields: [parentDeptId], references: [id])
  subDepartments Department[] @relation("SubDepartments")
  members        User[]       @relation("DepartmentMembers")

  @@index([orgId])
  @@map("departments")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  courses     Course[]

  @@index([slug])
  @@map("categories")
}

model Course {
  id                   String                @id @default(uuid())
  title                String
  slug                 String                @unique
  description          String
  shortDescription     String?
  thumbnail            String?
  previewVideo         String?
  level                CourseLevel           @default(BEGINNER)
  status               CourseStatus          @default(DRAFT)
  language             String                @default("en")
  duration             Int?
  price                Decimal               @default(0) @db.Decimal(10, 2)
  discountPrice        Decimal?              @db.Decimal(10, 2)
  instructorId         String
  orgId                String?
  categoryId           String?
  maxStudents          Int?
  enrollmentDeadline   DateTime?
  startDate            DateTime?
  endDate              DateTime?
  isPublic             Boolean               @default(true)
  allowReviews         Boolean               @default(true)
  certificateEnabled   Boolean               @default(true)
  passingScore         Int                   @default(70)
  viewCount            Int                   @default(0)
  enrollmentCount      Int                   @default(0)
  completionCount      Int                   @default(0)
  averageRating        Decimal?              @db.Decimal(3, 2)
  tags                 String[]              @default([])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  publishedAt          DateTime?
  courseCode           String?               @unique
  createdById          String?
  announcements        Announcement[]
  assignments          Assignment[]
  certificates         Certificate[]
  chatbotConversations ChatbotConversation[]
  analytics            CourseAnalytics[]
  chat                 CourseChat?
  requiredFor          CoursePrerequisite[]  @relation("RequiredCourse")
  prerequisites        CoursePrerequisite[]  @relation("PrerequisiteCourse")
  reviews              CourseReview[]
  category             Category?             @relation(fields: [categoryId], references: [id])
  createdBy            User?                 @relation("CourseCreator", fields: [createdById], references: [id])
  instructor           User                  @relation("CourseInstructor", fields: [instructorId], references: [id])
  organization         Organization?         @relation(fields: [orgId], references: [id])
  ctfCourse            CtfCourse?
  enrollmentCodes      EnrollmentCode[]
  enrollments          Enrollment[]
  modules              Module[]
  finalExams           FinalExam[] // Final exams that pull questions from this course

  @@index([slug])
  @@index([courseCode])
  @@index([instructorId])
  @@index([createdById])
  @@index([categoryId])
  @@index([status])
  @@index([level])
  @@map("courses")
}

model CoursePrerequisite {
  id                 String   @id @default(uuid())
  courseId           String
  prerequisiteId     String
  required           Boolean  @default(true)
  createdAt          DateTime @default(now())
  course             Course   @relation("RequiredCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse Course   @relation("PrerequisiteCourse", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@map("course_prerequisites")
}

model Module {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String
  orderIndex  Int
  duration    Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id             String           @id @default(uuid())
  title          String
  description    String?
  moduleId       String
  orderIndex     Int
  contentType    ContentType      @default(VIDEO)
  videoUrl       String?
  videoDuration  Int?
  content        String?
  attachments    String[]         @default([])
  duration       Int?
  points         Int              @default(10)
  isPreview      Boolean          @default(false)
  isMandatory    Boolean          @default(true)
  isPublished    Boolean          @default(false)
  quizId         String?
  assignmentId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lessonProgress LessonProgress[]
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topics         Topic[]

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id                String           @id @default(uuid())
  userId            String
  courseId          String
  status            EnrollmentStatus @default(ACTIVE)
  progress          Int              @default(0)
  lastAccessedAt    DateTime?
  completedAt       DateTime?
  certificateIssued Boolean          @default(false)
  enrolledAt        DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  enrollmentCodeId  String?          @unique
  certificate       Certificate?
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentCode    EnrollmentCode?  @relation(fields: [enrollmentCodeId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress    LessonProgress[]
  topicProgress     TopicProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model EnrollmentCode {
  id            String      @id @default(uuid())
  code          String      @unique
  userId        String?
  userEmail     String
  courseId      String
  isUsed        Boolean     @default(false)
  usedAt        DateTime?
  expiresAt     DateTime?
  isRevoked     Boolean     @default(false)
  revokedAt     DateTime?
  revokedReason String?
  createdBy     String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment    Enrollment?

  @@index([code])
  @@index([userId])
  @@index([userEmail])
  @@index([courseId])
  @@index([isUsed])
  @@map("enrollment_codes")
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean    @default(false)
  timeSpent    Int        @default(0)
  lastPosition Int        @default(0)
  score        Int?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Topic {
  id           String              @id @default(uuid())
  title        String
  description  String?
  lessonId     String
  orderIndex   Int
  contentType  ContentType         @default(PDF)
  pdfUrl       String?
  videoUrl     String?
  duration     Int?
  pageCount    Int?
  isPublished  Boolean             @default(false)
  points       Int                 @default(10)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  highlights   TopicHighlight[]
  notes        TopicNote[]
  progress     TopicProgress[]
  relatedMedia TopicRelatedMedia[]
  lesson       Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId])
  @@map("topics")
}

model TopicRelatedMedia {
  id           String   @id @default(uuid())
  topicId      String
  title        String
  url          String
  thumbnailUrl String?
  description  String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_related_media")
}

model TopicHighlight {
  id           String   @id @default(uuid())
  topicId      String
  userId       String
  color        String   @default("#FFFF00")
  pageNumber   Int
  position     Json
  selectedText String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId, userId])
  @@map("topic_highlights")
}

model TopicNote {
  id          String   @id @default(uuid())
  topicId     String
  userId      String
  content     String
  pageNumber  Int?
  highlightId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId, userId])
  @@map("topic_notes")
}

model TopicProgress {
  id               String     @id @default(uuid())
  topicId          String
  userId           String
  enrollmentId     String
  isCompleted      Boolean    @default(false)
  completedAt      DateTime?
  totalTimeSpent   Int        @default(0)
  lastAccessedAt   DateTime?
  lastPageViewed   Int        @default(1)
  maxPageViewed    Int        @default(1)
  pageTimeSpent    Json?
  scrollPercentage Int        @default(0)
  lastPosition     Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic            Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([topicId])
  @@index([userId])
  @@index([enrollmentId])
  @@map("topic_progress")
}

model Assignment {
  id                  String                 @id @default(uuid())
  title               String
  description         String
  instructions        String
  points              Int                    @default(100)
  dueDate             DateTime?
  availableFrom       DateTime?
  availableUntil      DateTime?
  maxAttempts         Int?
  allowLateSubmission Boolean                @default(false)
  latePenalty         Int?
  attachments         String[]               @default([])
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  type                String                 @default("Assignment")
  courseId            String?
  visibility          String                 @default("All Students")
  isPublished         Boolean                @default(false)
  submissions         AssignmentSubmission[]
  course              Course?                @relation(fields: [courseId], references: [id], map: "assignments_courseid_fkey")

  @@index([courseId], map: "assignments_courseid_idx")
  @@map("assignments")
}

model AssignmentSubmission {
  id            String           @id @default(uuid())
  assignmentId  String
  userId        String
  status        AssignmentStatus @default(PENDING)
  content       String
  attachments   String[]         @default([])
  score         Int?
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  attemptNumber Int              @default(1)
  isLate        Boolean          @default(false)
  submittedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId, attemptNumber])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
  @@map("assignment_submissions")
}

model Quiz {
  id                   String         @id @default(uuid())
  title                String
  description          String?
  instructions         String?
  timeLimit            Int?
  availableFrom        DateTime?
  availableUntil       DateTime?
  passingScore         Int            @default(70)
  maxAttempts          Int?
  shuffleQuestions     Boolean        @default(false)
  shuffleOptions       Boolean        @default(false)
  showCorrectAnswers   Boolean        @default(true)
  showScoreImmediately Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  attempts             QuizAttempt[]
  questions            QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String           @id @default(uuid())
  quizId        String
  type          QuizQuestionType @default(MULTIPLE_CHOICE)
  question      String
  explanation   String?
  points        Int              @default(1)
  orderIndex    Int
  options       Json?
  correctAnswer String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  answers       QuizAnswer[]
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id            String       @id @default(uuid())
  quizId        String
  userId        String
  attemptNumber Int          @default(1)
  score         Int          @default(0)
  maxScore      Int
  percentage    Decimal      @db.Decimal(5, 2)
  passed        Boolean      @default(false)
  timeSpent     Int?
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  answers       QuizAnswer[]
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId, attemptNumber])
  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id             String       @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  pointsEarned   Int          @default(0)
  answeredAt     DateTime     @default(now())
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_answers")
}

model Certificate {
  id                String            @id @default(uuid())
  certificateNumber String            @unique
  userId            String
  courseId          String
  enrollmentId      String            @unique
  title             String
  description       String?
  status            CertificateStatus @default(PENDING)
  fileUrl           String?
  qrCodeUrl         String?
  verificationUrl   String?
  score             Int?
  grade             String?
  completionDate    DateTime
  expiryDate        DateTime?
  issuedAt          DateTime          @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([certificateNumber])
  @@map("certificates")
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String
  type        BadgeType   @default(ACHIEVEMENT)
  points      Int         @default(0)
  rarity      String      @default("COMMON")
  conditions  Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model Achievement {
  id               String            @id @default(uuid())
  name             String            @unique
  description      String
  icon             String?
  points           Int               @default(0)
  conditions       Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  completed     Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Notification {
  id         String              @id @default(uuid())
  userId     String
  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  message    String
  data       Json?
  isRead     Boolean             @default(false)
  readAt     DateTime?
  actionUrl  String?
  actionText String?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  subject     String?
  content     String
  attachments String[]  @default([])
  isRead      Boolean   @default(false)
  readAt      DateTime?
  parentId    String?
  createdAt   DateTime  @default(now())
  parent      Message?  @relation("MessageThread", fields: [parentId], references: [id])
  replies     Message[] @relation("MessageThread")
  receiver    User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId, isRead])
  @@map("messages")
}

model Forum {
  id          String      @id @default(uuid())
  title       String
  description String?
  slug        String      @unique
  courseId    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  posts       ForumPost[]

  @@index([slug])
  @@map("forums")
}

model ForumPost {
  id          String         @id @default(uuid())
  forumId     String
  authorId    String
